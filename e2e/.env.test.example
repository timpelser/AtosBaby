# Copy this file to e2e/.env.test and fill in real values.
# e2e/.env.test is gitignored — never commit real secrets here.
#
# See e2e/README.md for where each value comes from.

# --- Neon branch reset (global-setup.ts) ---
NEON_API_KEY=
NEON_PROJECT_ID=shiny-water-94472315
NEON_E2E_BRANCH_ID=br-withered-breeze-aljv378w
NEON_E2E_SEED_BRANCH_ID=br-quiet-dust-al0c9uzn

# --- App env, used by the `npm run dev` instance Playwright boots ---
# Connection string for the `e2e` branch above (NOT prod!). Get it with:
#   Neon console > atos-baby-db > Branches > e2e > Connect
DATABASE_URL=

# These do NOT need to match the real production secrets — the e2e app
# instance is its own process, so any fixed values work as long as they're
# consistent across local/CI runs.
ADMIN_PASSWORD=e2e-admin-test-password
CRON_SECRET=e2e-cron-test-secret
